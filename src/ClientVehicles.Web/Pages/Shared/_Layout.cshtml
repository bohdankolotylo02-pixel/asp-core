@{
    var currentPath = ViewContext.HttpContext.Request.Path.Value ?? string.Empty;
    var onClients = currentPath.StartsWith("/Clients", StringComparison.OrdinalIgnoreCase)
                    || currentPath == "/"
                    || currentPath.StartsWith("/Vehicles", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Clients &amp; Vehicles</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="app-header__inner">
            <a class="brand" asp-page="/Clients/Index">
                <span class="brand__mark">CV</span>
                <span class="brand__text">Clients &amp; Vehicles</span>
            </a>
            <nav class="app-nav">
                <a class="app-nav__link @(onClients ? "is-active" : null)" asp-page="/Clients/Index">Clients</a>
            </nav>
            <a class="btn btn--primary btn--sm" asp-page="/Clients/Create">New client</a>
        </div>
    </header>

    <main class="app-main">
        <partial name="_Flash" />
        @RenderBody()
    </main>

    <footer class="app-footer">
        <span>Clients &amp; Vehicles</span>
        <span class="app-footer__sep">/</span>
        <span>Assessment build</span>
    </footer>

    <div class="modal" id="confirm-modal" hidden>
        <div class="modal__backdrop" data-confirm-cancel></div>
        <div class="modal__panel" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
            <h2 class="modal__title" id="confirm-modal-title">Please confirm</h2>
            <p class="modal__text" id="confirm-modal-text"></p>
            <div class="modal__actions">
                <button type="button" class="btn btn--ghost" data-confirm-cancel>Cancel</button>
                <button type="button" class="btn btn--danger" id="confirm-modal-accept">Confirm</button>
            </div>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
