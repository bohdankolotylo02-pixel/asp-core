@page "{clientId:int}"
@model ClientVehicles.Web.Pages.Vehicles.CreateModel
@{
    ViewData["Title"] = "Add vehicle";
}

<div class="breadcrumb">
    <a asp-page="/Clients/Index">Clients</a> /
    <a asp-page="/Clients/Details" asp-route-id="@Model.ClientId">@Model.ClientName</a> / Add vehicle
</div>

<div class="page-head">
    <div class="page-head__text">
        <h1>Add vehicle</h1>
        <p class="page-head__sub">This vehicle will belong to @Model.ClientName.</p>
    </div>
</div>

<form method="post" novalidate data-validate>
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="card">
        <div class="card__body">
            <div class="form-grid">
                <div class="field">
                    <label asp-for="Input.LicensePlate">License plate <span class="req">*</span></label>
                    <input asp-for="Input.LicensePlate" required autocomplete="off" placeholder="12-AB-34" autofocus />
                    <span asp-validation-for="Input.LicensePlate" class="field-error"></span>
                    <span class="hint">Stored in upper case. Spaces and dashes are ignored when checking for duplicates.</span>
                </div>
                <div class="field">
                    <label asp-for="Input.Vin">VIN</label>
                    <input asp-for="Input.Vin" autocomplete="off" />
                    <span asp-validation-for="Input.Vin" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Brand">Brand <span class="req">*</span></label>
                    <input asp-for="Input.Brand" required autocomplete="off" />
                    <span asp-validation-for="Input.Brand" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Model">Model <span class="req">*</span></label>
                    <input asp-for="Input.Model" required autocomplete="off" />
                    <span asp-validation-for="Input.Model" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Mileage">Current mileage (km)</label>
                    <input asp-for="Input.Mileage" type="number" min="0" step="1" autocomplete="off" />
                    <span asp-validation-for="Input.Mileage" class="field-error"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn--primary" data-busy-label="Saving...">Add vehicle</button>
                <a class="btn btn--ghost" asp-page="/Clients/Details" asp-route-id="@Model.ClientId">Cancel</a>
            </div>
        </div>
    </div>
</form>
