<?xml version="1.0" encoding="utf-8"?>
<!-- Pins the package source for this repository so a clean clone restores the same way
     on any machine, regardless of the machine level NuGet configuration. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
